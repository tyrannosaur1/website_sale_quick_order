#. module: website_sale_quick_order
#. odoo-python
#: code:addons/website_sale_quick_order/models/quick_order.py:0
msgid "No product matches this reference."
msgstr "Geen enkel product komt overeen met deze referentie."

#. module: website_sale_quick_order
#. odoo-python
#: code:addons/website_sale_quick_order/models/quick_order.py:0
msgid "No quantity on this line: write the reference, a space, then the quantity."
msgstr "Geen hoeveelheid op deze regel: schrijf de referentie, een spatie en dan de hoeveelheid."

#. module: website_sale_quick_order
#. odoo-python
#: code:addons/website_sale_quick_order/models/quick_order.py:0
msgid "Nothing was added to your cart."
msgstr "Er is niets aan uw winkelmandje toegevoegd."

#. module: website_sale_quick_order
#: model_terms:ir.ui.view,arch_db:website_sale_quick_order.quick_order_page
msgid ""
"One product per line: the reference, then the quantity.\n"
"                        A reference is the internal reference of the product or\n"
"                        its barcode. Separate the two with a space, a tab, a\n"
"                        semicolon or a comma, and repeat a reference to add its\n"
"                        quantities together."
msgstr "Eén product per regel: eerst de referentie, dan de hoeveelheid. Een referentie is de interne referentie van het product of de streepjescode ervan. Scheid beide met een spatie, een tab, een puntkomma of een komma, en herhaal een referentie om de hoeveelheden op te tellen."

#. module: website_sale_quick_order
#: model:ir.model,name:website_sale_quick_order.model_product_product
msgid "Product Variant"
msgstr "Productvariant"

#. module: website_sale_quick_order
#: model:ir.module.module,shortdesc:base.module_website_sale_quick_order
