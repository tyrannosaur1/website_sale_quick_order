msgstr "De lijst is beperkt tot %(max)s regels; er zijn %(count)s geplakt."

#. module: website_sale_quick_order
#. odoo-python
#: code:addons/website_sale_quick_order/models/quick_order.py:0
msgid "The quantity must be greater than zero."
msgstr "De hoeveelheid moet groter zijn dan nul."

#. module: website_sale_quick_order
#. odoo-python
#: code:addons/website_sale_quick_order/models/quick_order.py:0
